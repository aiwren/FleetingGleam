{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FleetingGleam",
  "version": "0.1.0",
  "identifier": "com.fleetinggleam.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "FleetingGleam",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
    "assetProtocol": { "enable": true, "scope": ["$CACHE/**", "$APPCACHE/**", "$HOME/**", "/Volumes/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
