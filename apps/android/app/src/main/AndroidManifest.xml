<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 联网只做三件事：下载模型、连用户自己的 NAS、备份到用户自己的云存储。照片不会发出去。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 读相册里的照片（Android 13 起是 READ_MEDIA_IMAGES；14 起用户可以只给部分照片） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- 分析期间的前台服务与它的通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 分析期间不让 CPU 睡（熄屏也接着分析），以及请系统别"优化"本应用的电量（切到后台不被停掉） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- 应用内更新：不在应用商店，新版本的 APK 从 GitHub Releases 下到私有缓存后交给系统安装器（用户要先允许"安装未知应用"） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 允许用 simpleperf / Perfetto 对发布包采样（不是 debuggable；Google 建议发布包都这么标） -->
    <!-- 关于页的半屏浏览器要找到支持 Custom Tabs 的浏览器（Android 11+ 的包可见性） -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".FgApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.FleetingGleam">
        <!-- 高通 NPU：QNN 的 HTP 驱动要通过系统的 libcdsprpc.so 和 DSP 通信。Android 12 起应用要用这种厂商公开库必须在这里声明，
             否则应用进程里 dlopen 找不到它，NPU 设备建不起来、模型整个落回 CPU（2026-10-23 真机）。required=false：非高通手机照常安装 -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <profileable android:shell="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".service.AnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- 把下好的更新包（cache/updates/）给系统安装器读（core/Updates.kt） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
