    "type": "git",
    "url": "git+https://github.com/lcopilot/FleetingGleam.git"
  },
  "bugs": {
    "url": "https://github.com/lcopilot/FleetingGleam/issues"
  },
  "homepage": "https://github.com/lcopilot/FleetingGleam#readme"
}
