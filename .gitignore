# dependencies and build output
node_modules
dist
dist-ssr
.output
.nitro
.tanstack
.vinxi
target
*.local
*.log

# models never go into the repo (see docs/MODELS.md); the few small converted files that ship with the app are in packages/core/model-data/
apps/desktop/models/
*.onnx
# 随应用编进去的小模型（整包不到 10 MB，modelfiles.rs 用 include_bytes! 读）要进仓库，否则别处编不过
!packages/core/model-data/*.onnx
.env
.env.*
!.env.example
*.key

# generated
apps/desktop/src-tauri/resources/
apps/desktop/src-tauri/gen/

# editors / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?

# real sample photographs for screenshots (not redistributed)
apps/desktop/public/dev-photos/

# 本地 AI 工具的工作目录（里面有本机绝对路径，不公开）
.claude/
.impeccable/

# 由 apps/desktop/scripts/build-vision.sh 从 Swift 源码生成的 macOS 辅助程序，不提交编译产物
apps/desktop/src-tauri/bin/

# 宣传物料（视频、图片、文案）和它们的源文件：只放在本机，不进仓库
marketing/
